# kalauiwribilangboss defaults. CLI flags override these values.
# Copy to .env and edit: cp .env.example .env

# iPhone running VTube Studio (required). Shown in the iOS app.
IPHONE_IP=

# Which outputs to use: vts (primary), osf, or both. OSF is unmaintained
# for now — model doesn't move over Proton UDP, cause unknown.
OUT=vts

# OpenSeeFace UDP target (VTube Studio PC input)
VTS_IP=127.0.0.1
VTS_PORT=11573

# VTube Studio Plugin API websocket
VTS_WS_URL=ws://127.0.0.1:8001
PLUGIN_NAME=kalauiwribilangboss
PLUGIN_DEVELOPER=kalauiwribilangboss
TOKEN_FILE=.vts_token
VTS_RATE=30
VTS_POS_GAIN=0.3
VTS_POS_Z_GAIN=0.15
VTS_POS_JUMP=0.25
ROLL_GAIN=0.15
BROW_SIGN=1
YAW_SIGN=1
PITCH_SIGN=-1
ROLL_SIGN=1
# 1 mirrors left-right (yaw, roll, position X); 0 disables
MIRROR=1

# iPhone feed options
IPHONE_PORT=21412
LISTEN_PORT=11125
SENT_BY=kalauiwribilangboss
REQUEST_TIME=5
KEEPALIVE_MS=500
SEND_HZ=60

# Mapping tuning
FACE_ID=0
WIDTH=640
HEIGHT=480
SMOOTH=0.5
POS_SMOOTH=0.85
ROLL_SMOOTH=0.8
POS_SCALE=4
ROT_SCALE=1
POS_MAX=6
POS_JUMP=1.5
POS_DEAD=0.02
POS_REBASE=10
POS_LEAK=0.005
ROT_LEAK=0.001
# Set to 1 to disable auto-zero of the head-position baseline
NO_ZERO=
# Set to 1 to disable auto-zero of the head-rotation neutral
NO_ROT_ZERO=
